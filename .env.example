# ---------------- Base de datos ----------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_estacion_demo
# Opcionales
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=false

# ---------------- JWT ----------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------- CORS (panel web) ----------------
# Orígenes separados por coma. Vacío = sin CORS (la app móvil no lo necesita)
CORS_ORIGINS=

# ---------------- Pronóstico ----------------
# FORECAST_URL=https://pronostico.iagro360.xyz/forecast/daytramo
# FORECAST_CACHE_TTL_SECONDS=600
# HTTP_TIMEOUT_SECONDS=30
